# demo is scripted; live calls the selected Gemini model and incurs provider charges.
AGENT_MODE=demo
GEMINI_MODEL=gemini-flash-latest
GOOGLE_API_KEY=
# For Vertex AI instead: GOOGLE_GENAI_USE_VERTEXAI=true plus project and location.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
DATABASE_PATH=data/suite.db
# Optional PostgreSQL / AlloyDB DSN, with TLS. Blank selects SQLite.
DATABASE_URL=
SESSION_DATABASE_URL=sqlite+aiosqlite:///data/sessions.db
# JSON maps bearer tokens to trusted customer identities. Generate strong tokens.
# Empty means all protected HTTP endpoints reject requests.
API_TOKENS={}
WORKSPACE_ROOT=examples
GEMINI_CLI_BINARY=gemini
GEMINI_CLI_TIMEOUT=90
REVIEW_TEST_MODE=skip
SUITE_CONCURRENCY=4
SUITE_REQUEST_TIMEOUT=180

# Optional remote MCP Toolbox catalog (live mode; never point demos at real inventory).
CATALOG_MCP_URL=
CATALOG_MCP_TOKEN=
